{
  "name": "earscribe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-pwa-manifest.mjs && next build && node scripts/build-404.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs scripts/seo/*.test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test:release-check": "node --test scripts/release-id.test.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:quality": "node scripts/i18n-quality.mjs",
    "i18n:gate": "node scripts/i18n-quality.mjs --gate",
    "i18n:apply": "node scripts/i18n-apply.mjs",
    "pages:deploy": "pnpm release:check && pnpm build && node scripts/link-audit.mjs && node scripts/guides-audit.mjs && node scripts/llms-txt-audit.mjs && node scripts/readme-audit.mjs && node scripts/i18n-quality.mjs --gate && node scripts/sitemap-audit.mjs && node scripts/pwa-audit.mjs && pnpm seo:check && wrangler pages deploy out --project-name earscribe --branch main",
    "pages:deploy:production": "pnpm pages:deploy",
    "link:audit": "node scripts/link-audit.mjs",
    "guides:audit": "node scripts/guides-audit.mjs",
    "llms:audit": "node scripts/llms-txt-audit.mjs",
    "readme:audit": "node scripts/readme-audit.mjs",
    "sitemap:audit": "node scripts/sitemap-audit.mjs",
    "sitemap:update": "node scripts/sitemap-audit.mjs --update",
    "pwa:icons": "node scripts/build-pwa-icons.mjs",
    "pwa:manifest": "node scripts/build-pwa-manifest.mjs",
    "pwa:audit": "node scripts/pwa-audit.mjs",
    "guides:ui": "node scripts/guides-ui-check.mjs --shots",
    "seo:seed": "node scripts/seo/seed-registry.mjs",
    "seo:packs": "node scripts/seo/pack-check.mjs",
    "seo:visual": "node scripts/seo/visual-audit.mjs",
    "seo:diversity": "node scripts/seo/diversity-audit.mjs",
    "seo:cursor": "node scripts/seo/cursor-audit.mjs",
    "seo:check": "node scripts/seo/pack-check.mjs && node scripts/seo/keyword-audit.mjs && node scripts/seo/visual-audit.mjs && node scripts/seo/diversity-audit.mjs && node scripts/seo/faq-audit.mjs && node scripts/seo/cursor-audit.mjs && node scripts/seo/content-audit.mjs --summary",
    "seo:faq": "node scripts/seo/faq-audit.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs feedback",
    "seo:keyword": "node scripts/seo/keyword-audit.mjs",
    "seo:gsc": "node scripts/seo/gsc-index-report.mjs",
    "seo:gsc:sitemaps": "node scripts/seo/gsc-index-report.mjs --sitemaps",
    "seo:gsc:queries": "node scripts/seo/gsc-index-report.mjs --queries"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "lucide-react": "^0.469.0",
    "mediabunny": "^1.44.2",
    "next": "15.2.9",
    "next-intl": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260310.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.2.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.7.2",
    "wrangler": "^4.71.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@8.9.0"
}
